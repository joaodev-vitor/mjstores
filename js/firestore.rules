rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'monteiropeixotosilvaj@gmail.com';
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow create: if true;
      // Cliente lê SÓ os próprios pedidos; admin lê todos
      allow read: if isAdmin()
        || (request.auth != null
            && request.auth.token.email == resource.data.cliente.email);
      allow update, delete: if isAdmin();
    }

    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userUid);
    }

    match /refunds/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin()
        || (request.auth != null
            && request.auth.token.email == resource.data.cliente.email);
    }
  }
}